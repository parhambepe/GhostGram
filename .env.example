# =================================================================
# 📱 TELEGRAM API CREDENTIALS (https://my.telegram.org/apps)
# =================================================================
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=YOUR_PHONE_NUMBER_WITH_COUNTRY_CODE

# =================================================================
# 🧠 GEMINI (comma-separated keys = round-robin + failover)
# =================================================================
GEMINI_API_KEYS=YOUR_GEMINI_KEY
MODEL_NAME=gemini-3.5-flash-lite

# =================================================================
# 👤 IDENTITY
# =================================================================
# Telegram numeric user id of the owner (the account the bot runs on)
OWNER_ID=YOUR_TELEGRAM_USER_ID
# Display name the bot answers as (used in group mention detection & prompts)
PERSONA_NAME=شایان

# =================================================================
# ☁️ RAILWAY / CLOUD DEPLOYMENT (recommended)
# =================================================================
# Generate ONCE with:  python3 gen_session_string.py
SESSION_STRING=
SESSION_NAME=teleagent_session

# Persistent storage: Railway volume mount point (state files survive restarts)
DATA_DIR=/app/data

# =================================================================
# ⚙️ TUNING (optional — defaults are fine)
# =================================================================
# Gemini hard timeout per attempt in seconds; web-search uses SEARCH_TIMEOUT
GEMINI_TIMEOUT=15
SEARCH_TIMEOUT=45
# Stealth confirmations to Saved Messages (1=on), auto-delete after N seconds
STEALTH_CONFIRM=1
CONFIRM_AUTO_DELETE_SECONDS=10
# Push engine errors to Saved Messages instead of failing silently
NOTIFY_ERRORS=1

# =================================================================
# 🖥 VPS DEPLOY ONLY (deploy.sh) — not needed on Railway
# =================================================================
VPS_IP=YOUR_VPS_IP
SSH_USER=root
SSH_PORT=22